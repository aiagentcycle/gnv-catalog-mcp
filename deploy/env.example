# Environment for gnv-catalog-mcp. No secrets: the server only reads public shop feeds.
# Shop origin (https, no path). Outbound requests go only to this host.
GNV_CATALOG_ORIGIN=https://goodnaturevibe.com
# Local port; nginx proxies to 127.0.0.1:8325.
GNV_CATALOG_PORT=8325
# Only 127.0.0.1 is accepted.
GNV_CATALOG_BIND=127.0.0.1
# Optional JSONL log of tool calls (tool name, ok/code, duration, SHA-256 of the arguments; never IP addresses).
GNV_CATALOG_LOG=/var/log/gnv-catalog-mcp/tools.jsonl
